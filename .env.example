# buildboard environment (all optional — defaults shown)

# SQLite database file. Default: the repo's data/buildboard.db
#BUILDBOARD_DB=/path/to/buildboard.db

# Working directory the subagent runner uses (and reports in the prompt).
# Default: the buildboard repo root, resolved from the app's own location.
#BUILDBOARD_AGENT_DIR=/path/to/work/dir

# Shell command used to run a subagent. Default:
#   opencode run --format json --agent <agent> --dir <dir> <prompt>
#BUILDBOARD_AGENT_CMD=opencode run --format json

# Hard timeout for a subagent run (ms). Default: 600000 (10 min).
#BUILDBOARD_AGENT_TIMEOUT_MS=300000

# Escalation delay before SIGKILL after SIGTERM on cancel/timeout (ms). Default: 5000.
#BUILDBOARD_AGENT_KILL_MS=5000
